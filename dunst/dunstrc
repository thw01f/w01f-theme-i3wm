[global]
    font = JetBrainsMono Nerd Font 8
    format = "<b>%s</b>\n%b"

    # Size and positioning
    width = 300
    height = 100
    offset = 10x38
    origin = top-right

    # Red Borders
    frame_width = 2
    frame_color = "#FF0000"
    separator_color = "#FF0000"

    # Padding
    padding = 12
    horizontal_padding = 12

[urgency_low]
    background = "#000000"
    foreground = "#dddddd"
    timeout = 5

[urgency_normal]
    background = "#000000"
    foreground = "#dddddd"
    timeout = 5

[urgency_critical]
    background = "#FF0000"
    foreground = "#000000"
    frame_color = "#000000"
    timeout = 0
